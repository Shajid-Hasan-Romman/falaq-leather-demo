{
  "name": "falaq-v2.0",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run tailwind:build",
    "prestart": "npm run tailwind:build",
    "start": "ng serve",
    "dev": "concurrently -k -n tailwind,ng -c cyan,green \"npm run tailwind:watch\" \"ng serve\"",
    "prebuild": "npm run tailwind:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:falaq-v2.0": "node dist/falaq-v2.0/server/server.mjs",
    "generate:api": "ng-openapi-gen",
    "tailwind:build": "tailwindcss -i src/styles/theme.css -o src/styles/tailwind.generated.css --minify",
    "tailwind:watch": "tailwindcss -i src/styles/theme.css -o src/styles/tailwind.generated.css --watch"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
